# ng1-f5-emulator-netscaler — environment configuration
# Copy to .env and edit before deploying

# ── nG1 Authentication ────────────────────────────────────────────
# These credentials go into nGeniusONE BIG-IP Discovery configuration
TMOS_USERNAME=admin
TMOS_PASSWORD=netscout1

# ── TLS ───────────────────────────────────────────────────────────
TLS_CERT=certs/cert.pem
TLS_KEY=certs/key.pem
PORT=8443

# ── Host IP ───────────────────────────────────────────────────────
# IP of the host running this container — returned to nG1 in device info
TMOS_HOST_IP=192.168.1.10

# ── Backends file ─────────────────────────────────────────────────
BACKENDS_FILE=/app/backends.yml
